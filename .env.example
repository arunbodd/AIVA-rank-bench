# AIVA API configuration — copy to `.env` and fill in your own credentials.
# Used by scripts/predict_genes.py (and benchmark_gene_ranking.py).
# Bring your own API key; nothing here is shipped with the repo.

# Required: your AIVA API bearer token
AIVA_API_KEY=

# Optional overrides (defaults shown)
# AIVA_API_URL=https://api.aivaportal.com/agents/chat/stream
# AIVA_MODEL=google/gemini-3.1-pro-preview
# CONCURRENCY_LIMIT=3

# ── Optional path overrides ───────────────────────────────────────────────────
# All default to repo-bundled data; set only if your data lives elsewhere.
# AIVA_BENCHMARK_INPUTS=inputs/benchmark_inputs.jsonl
# AIVA_VCF_DIR=inputs/vcfs
# AIVA_RESULTS=results/aiva_rankings.jsonl      # AIVA predictions you generate
# AIVA_HGNC_PATH=data/hgnc_complete_set.txt     # optional HGNC complete set
